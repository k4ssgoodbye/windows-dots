{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#88C0D0",
          "template": "[{{ .Path }}]"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#E5E9F0",
          "template": " [{{ .UserName }}]\n"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#81A1C1",
          "template": "λ"
        }
      ]
    }
  ]
}
