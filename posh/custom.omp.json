{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#c0c0dd",
          "template": "["
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#849da2",
          "template": "{{.Path}}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#c0c0dd",
          "template": "]\n"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#c3c7dd",
          "template": "λ"
        }
      ]
    }
  ]
}
